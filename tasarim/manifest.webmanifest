{
  "id": "./",
  "name": "Kenar Notu",
  "short_name": "Kenar Notu",
  "description": "PDF, EPUB ve çizgi roman okuma, kalemle not alma ve tekrar.",
  "description_localized": { "en": "Read PDFs, EPUBs and comics, take notes with your pen, and review what you learn." },
  "lang": "tr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0B0C11",
  "background_color": "#0B0C11",
  "categories": [
    "education",
    "productivity",
    "books"
  ],
  "icons": [
    { "src": "ikon/ikon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "ikon/ikon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "ikon/ikon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "ikon/ikon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "ikon/ikon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "ikon/ikon-tek-renk.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "monochrome" }
  ],
  "share_target": {
    "action": "./paylas",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "dosya",
          "accept": [
            ".pdf",
            ".epub",
            ".cbz",
            "application/pdf",
            "application/epub+zip",
            "application/vnd.comicbook+zip",
            "image/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "application/vnd.comicbook+zip": [
          ".cbz"
        ]
      }
    }
  ],
  "shortcuts": [
    { "name": "Kart çalış", "short_name": "Tekrar", "name_localized": { "en": "Study cards" }, "short_name_localized": { "en": "Review" }, "url": "./#tekrar", "icons": [{ "src": "ikon/ikon-192.png", "sizes": "192x192" }] },
    { "name": "Her yerde ara", "short_name": "Ara", "name_localized": { "en": "Search everywhere" }, "short_name_localized": { "en": "Search" }, "url": "./#arama", "icons": [{ "src": "ikon/ikon-192.png", "sizes": "192x192" }] },
    { "name": "İzlerim", "short_name": "İzlerim", "name_localized": { "en": "My marks" }, "short_name_localized": { "en": "My marks" }, "url": "./#izler", "icons": [{ "src": "ikon/ikon-192.png", "sizes": "192x192" }] }
  ]
}
